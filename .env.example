# Copy to .env and fill in. The React app talks only to the Spring Boot API.
VITE_API_BASE_URL=http://localhost:8080/api

# --- Backend environment (set these when starting the Spring Boot app) ---
# No real secrets are committed anywhere. All values below are placeholders.
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
RESEND_API_KEY=
FRONTEND_URL=http://localhost:5173