# Copy to .env for local development. The React app talks only to the Spring Boot API.
VITE_API_BASE_URL=http://localhost:8080/api

# --- Backend environment (set these when starting the Spring Boot app) ---
# No real secrets are committed anywhere. All values below are placeholders.

# REQUIRED. Must be a JDBC PostgreSQL URL. Supabase connection strings use the form
# postgresql://... — they MUST be prefixed with jdbc: (the app refuses to start otherwise):
#   jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://<host>:5432/postgres

# Username (defaults to postgres).
DB_USERNAME=postgres

# REQUIRED. The app refuses to start without it. Set it in your deployment
# platform's secret store; never commit a real value.
DB_PASSWORD=

# REQUIRED. HS256 signing secret, at least 32 random bytes. The app refuses to
# start without it.
JWT_SECRET=

# Optional. Resend API key for digest emails. Missing = digest dry-run (nothing sent).
RESEND_API_KEY=

# Optional. Email sender, e.g. "Pantry Tracker <digest@yourdomain.com>".
RESEND_FROM=

# Optional. Comma-separated allowlist of frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Server port (defaults to 8080).
PORT=8080